{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sosnotebookeinformatica",
  "main": "cloudflare.mjs",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/admin/login"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sos-notebook-db",
      "migrations_dir": "drizzle",
      "database_id": "e6c56d50-d388-431c-bd78-e2d0048c9de0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sos-notebook-imagens"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "little-poetry-b8d6.cloudflareaccess.com",
    "ADMIN_EMAIL": "Wandson@live.com",
    "ACCESS_AUD": "bd88081d31d72e36f6a5b53680be5dc7b1ea1c94459afdea35f4e0aa428562aa"
  }
}
